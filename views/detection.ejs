<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartAgri | Plant Doctor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#1F7D53",
                        "primary-dark": "#165c3d",
                        "surface-dark": "#18230F",
                        "surface-nav": "#27391C",
                        "text-muted": "#c1dcb0",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    
    <style>
            body {
    /* High-Profile Cinematic Farm Diagnostic - Ultra Clarity */
  background: linear-gradient(
    to bottom, 
    rgba(39, 57, 28, 0.98) 0%, 
    rgba(255, 255, 255, 0.1) 20%, 
    rgba(255, 255, 255, 0.2) 100%
), 
url('https://images.unsplash.com/photo-1560493676-04071c5f467b?auto=format&fit=crop&q=80&w=2560');
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
    font-family: 'Space Grotesk', sans-serif;
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow-x: hidden;
}

        .main-content {
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .glass-container {
            background: rgba(39, 57, 28, 0.8); 
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 50px;
            width: 100%;
            max-width: 520px;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-container:hover {
            transform: translateY(-5px);
            border-color: rgba(31, 125, 83, 0.5);
        }

        .form-title { color: #ffffff; font-weight: 700; font-size: 2.5rem; margin-bottom: 8px; letter-spacing: -0.02em; }
        .form-subtitle { color: #c1dcb0; font-weight: 400; font-size: 1.1rem; margin-bottom: 40px; opacity: 0.9; }

        input[type="file"] {
            margin: 20px 0;
            color: #c1dcb0;
            background: rgba(255, 255, 255, 0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            width: 100%;
            cursor: pointer;
            transition: border-color 0.3s;
        }

        input[type="file"]:hover { border-color: #1F7D53; }

        #image-preview {
            max-width: 240px;
            max-height: 240px;
            border-radius: 20px;
            margin: 20px auto;
            display: none;
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
            border: 3px solid #1F7D53;
            object-fit: cover;
        }

        .submit-btn {
            background-color: #1F7D53;
            color: white;
            padding: 18px;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: 700;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .submit-btn:hover {
            background-color: #165c3d;
            box-shadow: 0 10px 25px rgba(31, 125, 83, 0.5);
            transform: scale(1.02);
        }

        #result-box {
            margin-top: 35px;
            padding: 25px;
            border-radius: 20px;
            display: none;
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .healthy { background: rgba(31, 125, 83, 0.25); border: 1px solid #1F7D53; color: #ffffff; }
        .diseased { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ffffff; }
    </style>
</head>
<body>

<header id="main-nav" class="sticky top-0 z-50 w-full bg-surface-nav border-b border-white/10 shadow-lg">
    <div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3 group cursor-pointer" onclick="window.location='/dashboard'">
        <div class="w-12 h-12 flex items-center justify-center relative">
          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="agroGradient" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#4CAF50"/>
                <stop offset="100%" stop-color="#1B5E20"/>
              </linearGradient>
            </defs>
            <path d="M12 22L17.2 19V13L12 10L6.8 13V19L12 22Z" fill="#E8F5E9" fill-opacity="0.2" stroke="#2D5A27" stroke-width="0.5"/>
            <path d="M12 14C12 14 7 12 5 7C5 3 9 2 12 7V14Z" fill="url(#agroGradient)" />
            <path d="M12 14C12 14 17 12 19 7C19 3 15 2 12 7V14Z" fill="#81C784" />
            <path d="M12 21V10" stroke="#1B5E20" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="flex flex-col leading-tight hidden md:block">
          <h1 class="text-xl font-bold tracking-tight text-white">Smart<span class="text-primary font-black">Agri</span></h1>
          <span class="text-[10px] uppercase tracking-[0.2em] text-primary/80 font-bold">Systems AI</span>
        </div>
      </div>

      <nav class="hidden md:flex items-center gap-8">
        <a href="/dashboard?name=<%= typeof userName !== 'undefined' ? userName : '' %>" class="text-text-muted hover:text-primary transition-colors font-medium">Home</a>
        <!-- <a href="/about?name=<%= typeof userName !== 'undefined' ? userName : '' %>" class="text-text-muted hover:text-primary transition-colors font-medium">About Us</a> -->
      </nav>
      
      <div class="flex items-center">
        <div class="relative group">
          <button class="profile-btn flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/5 transition-all">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold ring-2 ring-white/20 group-hover:ring-primary transition-all">
              <% if (typeof userName !== 'undefined' && userName) { %>
                <span class="text-lg uppercase"><%= userName.charAt(0) %></span>
              <% } else { %>
                <span class="material-symbols-outlined">person</span>
              <% } %>
            </div>
            <span class="text-sm font-medium text-white hidden lg:block"><%= typeof userName !== 'undefined' ? userName : 'Guest' %></span>
            <span class="material-symbols-outlined text-sm text-white/70">expand_more</span>
          </button>
          
          <div class="absolute right-0 mt-2 w-48 bg-surface-nav border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 text-sm text-text-muted hover:text-white hover:bg-white/5 transition-colors">
              <span class="material-symbols-outlined text-sm">logout</span> Logout
            </a>
          </div>
        </div>
      </div>
    </div>
</header>

<div class="main-content">
    <div class="glass-container">
        <div class="flex justify-center mb-6">
            <div class="p-4 bg-primary/10 rounded-full border border-primary/20">
                <span class="material-symbols-outlined text-primary text-5xl">biotech</span>
            </div>
        </div>
        <h1 class="form-title">Plant Doctor</h1>
        <h3 class="form-subtitle">AI-Powered Crop Leaf Disease Analysis</h3>
        
        <form id="upload-form">
            <input type="file" id="image-input" accept="image/*" required>
            <img id="image-preview" src="#" alt="Leaf Preview">
            <button type="submit" class="submit-btn">
                <span class="material-symbols-outlined">query_stats</span>
                Run Diagnostic
            </button>
        </form>

        <div id="result-box">
            <h2 id="prediction-text" class="text-2xl font-bold mb-2 tracking-tight"></h2>
            <p id="confidence-text" class="text-md font-medium opacity-90"></p>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById('upload-form');
    const resultBox = document.getElementById('result-box');
    const imageInput = document.getElementById('image-input');
    const imagePreview = document.getElementById('image-preview');

    imageInput.onchange = evt => {
        const [file] = imageInput.files;
        if (file) {
            imagePreview.src = URL.createObjectURL(file);
            imagePreview.style.display = 'block';
            resultBox.style.display = 'none';
        }
    }

    form.onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData();
        formData.append('leafImage', imageInput.files[0]);
        
        try {
            const response = await fetch('/predict-disease', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            
            if (data.error) {
                alert("Error: " + data.error);
                return;
            }

            resultBox.style.display = 'block';
            document.getElementById('prediction-text').innerText = data.prediction;
            document.getElementById('confidence-text').innerText = "Confidence: " + data.confidence;
            resultBox.className = data.status === 'Healthy' ? 'healthy' : 'diseased';
        } catch (err) {
            console.error("Analysis failed:", err);
        }
    };
</script>

</body>
</html>