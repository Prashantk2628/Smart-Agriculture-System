<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>SmartAgri | Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link rel="stylesheet" href="dashboard_style.css">
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#1F7D53",
            "primary-dark": "#165c3d",
            "surface-dark": "#18230F",
            "surface-nav": "#27391C",
            "surface-card": "#255F38",
            "text-main": "#f8f7f6",
            "text-muted": "#c1dcb0",
          },
          fontFamily: {
            "display": ["Space Grotesk", "sans-serif"],
            "body": ["Space Grotesk", "sans-serif"],
          }
        },
      },
    }
  </script>
</head>

<body class="bg-surface-dark min-h-screen flex flex-col font-display antialiased selection:bg-primary selection:text-white">
  <header id="main-nav" class="sticky top-0 z-50 w-full bg-surface-nav border-b border-white/10 shadow-lg transition-all duration-300">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-2">
      
      <div class="flex items-center gap-2 sm:gap-3 group cursor-pointer shrink-0">
        <div class="high-profile-logo w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center relative">
          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="agroGradient" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#4CAF50"/>
                <stop offset="100%" stop-color="#1B5E20"/>
              </linearGradient>
              <filter id="softShadow" x="-2" y="-2" width="28" height="28">
                <feGaussianBlur in="SourceAlpha" stdDeviation="0.5"/>
                <feOffset dx="0" dy="1" result="offsetblur"/>
                <feComponentTransfer>
                  <feFuncA type="linear" slope="0.3"/>
                </feComponentTransfer>
                <feMerge>
                  <feMergeNode/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>
            <path d="M12 22L17.2 19V13L12 10L6.8 13V19L12 22Z" fill="#E8F5E9" fill-opacity="0.2" stroke="#2D5A27" stroke-width="0.5"/>
            <path filter="url(#softShadow)" d="M12 14C12 14 7 12 5 7C5 3 9 2 12 7V14Z" fill="url(#agroGradient)" />
            <path filter="url(#softShadow)" d="M12 14C12 14 17 12 19 7C19 3 15 2 12 7V14Z" fill="#81C784" />
            <path d="M12 21V10" stroke="#1B5E20" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="flex flex-col leading-tight hidden md:block">
          <h1 class="text-lg sm:text-xl font-bold tracking-tight text-white">
            Smart<span class="text-primary font-black">Agri</span>
          </h1>
          <span class="text-[8px] sm:text-[10px] uppercase tracking-[0.2em] text-primary/80 font-bold">Systems AI</span>
        </div>
      </div>

      <nav class="flex items-center gap-4 sm:gap-8 px-2">
        <a href="/dashboard?name=<%= userName %>" class="text-primary font-medium text-sm sm:text-base transition-colors hover:text-green-400 whitespace-nowrap">Home</a>
        <!-- <a href="/about?name=<%= userName %>" class="text-text-muted hover:text-primary transition-colors duration-200 font-medium text-sm sm:text-base whitespace-nowrap">About Us</a> -->
      </nav>
      
      <div class="flex items-center shrink-0">
        <div class="relative group">
          <button class="profile-btn flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-2 rounded-xl hover:bg-white/5 transition-all">
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold ring-2 ring-white/20 group-hover:ring-primary transition-all overflow-hidden">
                <% if (typeof userName !== 'undefined' && userName) { %>
                  <span class="text-base sm:text-lg uppercase"><%= userName.charAt(0) %></span>
                <% } else { %>
                  <span class="material-symbols-outlined text-sm sm:text-base">person</span>
                <% } %>
              </div>
              <span class="text-sm font-medium text-white hidden lg:block"><%= typeof userName !== 'undefined' ? userName : 'Guest' %></span>
              <span class="material-symbols-outlined text-sm text-white/70">expand_more</span>
          </button>

          <div class="absolute right-0 mt-2 w-48 bg-surface-nav border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 text-sm text-text-muted hover:text-white hover:bg-white/5 transition-colors">
              <span class="material-symbols-outlined text-sm">logout</span>
              Logout
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-grow flex flex-col w-full max-w-[1440px] mx-auto px-6 py-8 gap-8">
    <section class="hero-section group relative overflow-hidden rounded-2xl p-10 flex items-center min-h-[300px]">
      <div class="absolute inset-0 z-0">
        <img alt="Precision Agriculture Aerial View" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&q=80&w=2000" />
        <div class="absolute inset-0 bg-gradient-to-r from-surface-dark via-surface-dark/90 to-surface-dark/20"></div>
      </div>
      <div class="relative z-10 max-w-2xl flex flex-col gap-4">
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 w-fit">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-xs font-semibold text-green-300 tracking-wide uppercase">System Online</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight">
          Welcome Back, <%= userName %>!
        </h2>
        <p class="text-lg md:text-xl text-text-muted font-light leading-relaxed max-w-lg">
          Monitoring your digital farm efficiency in real-time. Your automated systems are operating at peak performance.
        </p>
        
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface-nav rounded-2xl border border-white/10 p-6 flex items-center gap-6 relative overflow-hidden group cursor-pointer hover:bg-white/5 transition-all duration-300" 
      onclick="window.location.href='/recommend?name=<%= userName %>'">
        <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-opacity">
          <span class="material-symbols-outlined text-8xl text-white">water_drop</span>
        </div>
        <div class="flex flex-col gap-3 flex-grow">
          <div class="card-header">
            <div class="flex items-center gap-2 text-text-muted">
              <span class="material-symbols-outlined text-primary">opacity</span>
              <span class="text-sm font-semibold uppercase tracking-wider">Crop Environments</span>
            </div>
          </div>
          <div class="text-3xl font-bold text-white tracking-tight">Crop Recommendation</div>
          <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden mt-1">
            <div class="h-full bg-blue-400" style="width: 64%"></div>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-green-500/10 border border-green-500/20 w-fit mt-2">
            <span class="material-symbols-outlined text-sm text-green-400">check_circle</span>
            <span class="text-xs font-medium text-green-300">Optimal Levels</span>
          </div>
        </div>
      </div>

      <div class="bg-surface-nav rounded-2xl border border-white/10 p-6 flex items-center gap-6 relative overflow-hidden group cursor-pointer hover:bg-white/5 transition-all duration-300"
      onclick="window.location.href='/disease-detection?name=<%= userName %>'">
        <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-opacity"><span class="material-symbols-outlined text-8xl text-white">potted_plant</span></div>
        <div class="flex flex-col gap-3 flex-grow">
          <div class="card-header">
            <div class="flex items-center gap-2 text-text-muted">
              <span class="material-symbols-outlined text-primary">spa</span>
              <span class="text-sm font-semibold uppercase tracking-wider">Crop Health</span>
            </div>
          </div>
          <div class="text-3xl font-bold text-white tracking-tight">Disease Detection</div>
          <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden mt-1"><div class="h-full bg-green-500" style="width: 98%"></div></div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/20 border border-primary/30 w-fit mt-2">
            <span class="material-symbols-outlined text-sm text-primary">trending_up</span>
            <span class="text-xs font-medium text-primary-300">+2% from last week</span>
          </div>
        </div>
      </div>

      <div class="bg-surface-nav rounded-2xl border border-white/10 p-6 flex items-center gap-6 relative overflow-hidden group cursor-pointer hover:bg-white/5 transition-all duration-300" 
      onclick="window.location.href='/profit-analyzer?name=<%= userName %>'">
        <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-opacity">
          <span class="material-symbols-outlined text-8xl text-white">monitoring</span>
        </div>
        <div class="flex flex-col gap-3 flex-grow">
          <div class="card-header">
            <div class="flex items-center gap-2 text-text-muted">
              <span class="material-symbols-outlined text-primary">currency_rupee</span>
              <span class="text-sm font-semibold uppercase tracking-wider">Market Insights</span>
            </div>
          </div>
          <div class="text-3xl font-bold text-white tracking-tight">Profit Analyser</div>
          <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden mt-1">
            <div class="h-full bg-orange-400" style="width: 75%"></div>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-orange-500/10 border border-orange-500/20 w-fit mt-2">
            <span class="material-symbols-outlined text-sm text-orange-400">trending_up</span>
            <span class="text-xs font-medium text-orange-300">Analyze Now</span>
          </div>
        </div>
      </div>
    </section>

    <section class="relative w-full h-[400px] rounded-2xl overflow-hidden group mt-4 border border-white/10 shadow-2xl bg-surface-nav">
      <div id="slider-container" class="relative w-full h-full">
        <div class="absolute inset-0 transition-transform duration-1000 ease-in-out slide">
          <img src="https://images.unsplash.com/photo-1559884743-74a57598c6c7?auto=format&fit=crop&q=80&w=1200" alt="Autonomous Drone Mapping" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/70 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8 md:p-12 max-w-2xl">
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-primary bg-primary/20 rounded-full border border-primary/30 backdrop-blur-md mb-4 inline-block">Aerial Surveillance</span>
            <h3 class="text-3xl md:text-4xl font-display font-bold text-white mb-2 tracking-tight">Autonomous Drone Mapping</h3>
            <p class="text-text-muted text-base md:text-lg font-light leading-relaxed">Real-time aerial surveillance for precision crop health and resource monitoring.</p>
          </div>
        </div>
        <div class="absolute inset-0 transition-transform duration-1000 ease-in-out slide">
          <img src="https://images.pexels.com/photos/2132227/pexels-photo-2132227.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Smart Irrigation" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/70 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8 md:p-12 max-w-2xl">
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-blue-400 bg-blue-500/20 rounded-full border border-blue-500/30 backdrop-blur-md mb-4 inline-block">Water Management</span>
            <h3 class="text-3xl md:text-4xl font-display font-bold text-white mb-2 tracking-tight">Smart Irrigation Systems</h3>
            <p class="text-text-muted text-base md:text-lg font-light leading-relaxed">Automated moisture tracking and precision water distribution to ensure optimal crop hydration while conserving vital resources.</p>
          </div>
        </div>
        <div class="absolute inset-0 transition-transform duration-1000 ease-in-out slide">
          <img src="https://images.unsplash.com/photo-1605000797499-95a51c5269ae?auto=format&fit=crop&w=1200&q=80" alt="Predictive Analytics" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/70 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8 md:p-12 max-w-2xl">
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-blue-400 bg-blue-500/20 rounded-full border border-blue-500/30 backdrop-blur-md mb-4 inline-block">Yield Optimization</span>
            <h3 class="text-3xl md:text-4xl font-display font-bold text-white mb-2 tracking-tight">Predictive Harvesting</h3>
            <p class="text-text-muted text-base md:text-lg font-light leading-relaxed">AI-driven data models to forecast the perfect harvest windows and maximize your profitability.</p>
          </div>
        </div>
      </div>

      <button id="prevSlide" class="absolute left-4 top-1/2 -translate-y-1/2 bg-surface-dark/60 hover:bg-primary text-white p-2.5 rounded-full backdrop-blur-xl transition-all duration-300 opacity-0 group-hover:opacity-100 border border-white/10 z-20">
        <span class="material-symbols-outlined text-xl">arrow_back_ios_new</span>
      </button>
      <button id="nextSlide" class="absolute right-4 top-1/2 -translate-y-1/2 bg-surface-dark/60 hover:bg-primary text-white p-2.5 rounded-full backdrop-blur-xl transition-all duration-300 opacity-0 group-hover:opacity-100 border border-white/10 z-20">
        <span class="material-symbols-outlined text-xl">arrow_forward_ios</span>
      </button>

      <div class="absolute bottom-6 right-8 flex gap-2 z-20">
        <button class="w-8 h-1.5 rounded-full bg-primary transition-all duration-300 slider-dot" data-target="0"></button>
        <button class="w-3 h-1.5 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300 slider-dot" data-target="1"></button>
        <button class="w-3 h-1.5 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300 slider-dot" data-target="2"></button>
      </div>
    </section>
  </main>

  <footer class="mt-auto border-t border-white/10 bg-surface-nav/50">
    <div class="max-w-[1440px] mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-white/20">grass</span>
        <p class="text-text-muted text-sm">© 2026 SmartAgri. All rights reserved.</p>
      </div>
      <div class="flex items-center gap-8 text-sm text-text-muted">
        <a class="hover:text-white transition-colors" href="#">Privacy Policy</a>
        <a class="hover:text-white transition-colors" href="#">Terms of Service</a>
        <a class="hover:text-white transition-colors" href="#">Contact Support</a>
      </div>
    </div>
  </footer>

  <script src="dashboard_script.js"></script>
</body>
</html>