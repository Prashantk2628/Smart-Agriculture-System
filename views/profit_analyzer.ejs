<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmartAgri | Profit Analyzer</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#1F7D53",
            "surface-dark": "#18230F",
            "surface-nav": "#27391C",
            "text-main": "#f8f7f6",
            "text-muted": "#c1dcb0",
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface-dark text-text-main font-['Space_Grotesk'] min-h-screen">
  
  <header id="main-nav" class="sticky top-0 z-50 w-full bg-surface-nav border-b border-white/10 shadow-lg">
    <div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
      
      <div class="flex items-center gap-3 group cursor-pointer" onclick="window.location='/dashboard'">
        <div class="high-profile-logo w-12 h-12 flex items-center justify-center relative">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="agroGradient" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#4CAF50"/>
                <stop offset="100%" stop-color="#1B5E20"/>
              </linearGradient>
            </defs>
            <path d="M12 22L17.2 19V13L12 10L6.8 13V19L12 22Z" fill="#E8F5E9" fill-opacity="0.2" stroke="#2D5A27" stroke-width="0.5"/>
            <path d="M12 14C12 14 7 12 5 7C5 3 9 2 12 7V14Z" fill="url(#agroGradient)" />
            <path d="M12 14C12 14 17 12 19 7C19 3 15 2 12 7V14Z" fill="#81C784" />
            <path d="M12 21V10" stroke="#1B5E20" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="flex flex-col leading-tight hidden sm:block">
          <h1 class="text-xl font-bold tracking-tight text-white">Smart<span class="text-primary font-black">Agri</span></h1>
          <span class="text-[10px] uppercase tracking-[0.2em] text-primary/80 font-bold">Systems AI</span>
        </div>
      </div>

      <nav class="hidden md:flex items-center gap-8">
        <a href="/dashboard?name=<%= userName %>" class="text-text-muted hover:text-primary transition-colors duration-200 font-medium">Home</a>
        <!-- <a href="/about?name=<%= userName %>" class="text-primary font-medium">About Us</a> -->
      </nav>
      
      <div class="flex items-center gap-4">
        <div class="relative group">
          <button class="profile-btn flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/5 transition-all">
    <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold ring-2 ring-white/20 group-hover:ring-primary transition-all overflow-hidden">
      <% if (typeof userName !== 'undefined' && userName) { %>
        <span class="text-lg uppercase"><%= userName.charAt(0) %></span>
      <% } else { %>
        <span class="material-symbols-outlined">person</span>
      <% } %>
    </div>
    <span class="text-sm font-medium text-white hidden lg:block"><%= typeof userName !== 'undefined' ? userName : 'Guest' %></span>
    <span class="material-symbols-outlined text-sm text-white/70">expand_more</span>
  </button>
          <div class="absolute right-0 mt-2 w-48 bg-surface-nav border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 text-sm text-text-muted hover:text-white hover:bg-white/5 transition-colors">
              <span class="material-symbols-outlined text-sm">logout</span> Logout
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>


  <main class="max-w-4xl mx-auto px-6 pt-14 pb-20">
    <div class="bg-surface-nav/30 rounded-3xl border border-white/10 p-8 md:p-12 backdrop-blur-xl shadow-2xl">
        <div class="flex items-center gap-4 mb-8">
            <span class="material-symbols-outlined text-primary text-4xl">payments</span>
            <h2 class="text-3xl font-bold tracking-tight">Crop Profit Analyzer</h2>
        </div>

        <form action="/calculate-profit" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">

    
            <!-- Preserve userName across form submission -->
            <input type="hidden" name="name" value="<%= typeof userName !== 'undefined' ? userName : '' %>">
            
            <!-- Crop Selection (UPDATED: unique sorted dropdown) -->
            <div class="space-y-2">
                <label class="text-sm font-medium text-text-muted px-1">Select Your Crop</label>
                <select name="cropName" id="cropSelect" class="w-full bg-surface-dark/50 border border-white/10 rounded-xl p-4 text-white outline-none focus:border-primary transition-colors">
                    <option value="">-- Select a Crop --</option>
                    <% if (typeof uniqueCrops !== 'undefined') { %>
                        <% uniqueCrops.forEach(crop => { %>
                            <option value="<%= crop %>" 
                                <%= (typeof selectedCrop !== 'undefined' && selectedCrop === crop) ? 'selected' : '' %>>
                                <%= crop %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            
            <!-- Variety Dropdown (NEW: dynamic based on selected crop) -->
            <div class="space-y-2">
                <label class="text-sm font-medium text-text-muted px-1">Crop Variety</label>
                <select name="variety" id="varietySelect" class="w-full bg-surface-dark/50 border border-white/10 rounded-xl p-4 text-white outline-none focus:border-primary transition-colors">
                    <option value="">-- Select Crop First --</option>
                </select>
                <!-- Variety validation error shown here -->
                <% if (typeof varietyError !== 'undefined' && varietyError) { %>
                    <p class="text-xs text-red-400 px-1 mt-1"><%= varietyError %></p>
                <% } %>
            </div>
            
            <!-- District Input with Fetch Button -->
            <div class="space-y-2">
                <label class="text-sm font-medium text-text-muted px-1">District</label>
                <div class="relative flex items-center">
                    <input type="text" name="district" id="districtInput" required placeholder="Enter or Fetch District"
                           class="w-full bg-surface-dark/50 border border-white/10 rounded-xl p-4 pr-[140px] text-white outline-none focus:border-primary transition-colors" 
                           value="<%= typeof selectedDistrict !== 'undefined' ? selectedDistrict : '' %>">
                    
                    <button type="button" id="fetchLocationBtn"
                            class="absolute right-2 top-2 bottom-2 bg-primary/20 text-primary hover:bg-primary hover:text-white px-4 rounded-lg text-sm font-semibold transition-all flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm" id="locationIcon">my_location</span>
                        <span id="fetchText">Fetch</span>
                    </button>
                </div>
                <p id="locationError" class="text-xs text-red-400 hidden px-1"></p>
            </div>

            <!-- Land Area Input -->
            <div class="space-y-2">
                <label class="text-sm font-medium text-text-muted px-1">Land Area (in Acres)</label>
                <input type="number" step="0.1" name="area" required placeholder="e.g. 5.5"
                       class="w-full bg-surface-dark/50 border border-white/10 rounded-xl p-4 text-white outline-none focus:border-primary transition-colors" 
                       value="<%= typeof selectedArea !== 'undefined' ? selectedArea : '' %>">
            </div>

            <!-- Submit Button -->
            <button type="submit" class="md:col-span-2 mt-4 bg-primary hover:bg-green-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/20 transition-all active:scale-[0.98]">
                Start Financial Analysis
            </button>
        </form>

        <!-- Results Section -->
        <% if(typeof result !== 'undefined' && result) { %>
            <div class="mt-12 pt-8 border-t border-white/10">
                <h3 class="text-xl font-bold mb-6 text-primary">Analysis Result for <%= result.crop %> <%= typeof result.variety !== 'undefined' && result.variety ? `(${result.variety})` : '' %></h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-5 bg-white/5 rounded-2xl border border-white/5">
                        <p class="text-xs text-text-muted uppercase tracking-widest mb-1">Total Investment</p>
                        <p class="text-2xl font-bold">₹<%= result.investment %></p>
                    </div>
                    <div class="p-5 bg-white/5 rounded-2xl border border-white/5">
                        <p class="text-xs text-text-muted uppercase tracking-widest mb-1">Expected Production</p>
                        <p class="text-2xl font-bold"><%= result.production %> Tonnes</p>
                    </div>
                    <div class="p-5 bg-white/5 rounded-2xl border border-white/5">
                        <p class="text-xs text-text-muted uppercase tracking-widest mb-1">Market Value</p>
                        <p class="text-2xl font-bold text-green-400">₹<%= result.marketValue %></p>
                    </div>
                    <div class="p-5 bg-primary/20 rounded-2xl border border-primary/30">
                        <p class="text-xs text-primary uppercase tracking-widest mb-1">Estimated Net Profit</p>
                        <p class="text-3xl font-black">₹<%= result.profit %></p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
  </main>

  <script type="application/json" id="cropData">
    <%- JSON.stringify(typeof cropVarietyMap !== 'undefined' ? cropVarietyMap : {}) %>
  </script>

  <script>
    // cropVarietyMap is injected by the server (EJS)
    const cropVarietyMap = JSON.parse(document.getElementById('cropData').textContent);
    const selectedCrop    = "<%= typeof selectedCrop !== 'undefined' ? selectedCrop : '' %>";
    const selectedVariety = "<%= typeof selectedVariety !== 'undefined' ? selectedVariety : '' %>";

    const cropSelect    = document.getElementById('cropSelect');
    const varietySelect = document.getElementById('varietySelect');

    function populateVarieties(cropName) {
        varietySelect.innerHTML = '';
        const varieties = cropVarietyMap[cropName];
        if (!varieties || varieties.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '-- No varieties available --';
            varietySelect.appendChild(opt);
            return;
        }
        // Add a default blank option
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = '-- Select a Variety --';
        varietySelect.appendChild(blank);

        varieties.forEach(v => {
            const opt = document.createElement('option');
            opt.value = v;
            opt.textContent = v;
            if (v === selectedVariety) opt.selected = true;
            varietySelect.appendChild(opt);
        });
    }

    // On crop change, reload varieties
    cropSelect.addEventListener('change', () => {
        populateVarieties(cropSelect.value);
    });

    // On page load: if a crop is already selected (e.g. after form submit), populate its varieties
    if (selectedCrop) {
        populateVarieties(selectedCrop);
    } else if (cropSelect.value) {
        populateVarieties(cropSelect.value);
    }
  </script>

  <script>
    document.getElementById('fetchLocationBtn').addEventListener('click', () => {
        const btn = document.getElementById('fetchLocationBtn');
        const fetchText = document.getElementById('fetchText');
        const icon = document.getElementById('locationIcon');
        const input = document.getElementById('districtInput');
        const errorText = document.getElementById('locationError');

        // Set Loading State
        fetchText.textContent = "Locating...";
        icon.classList.add('animate-spin');
        icon.textContent = "sync";
        btn.disabled = true;
        btn.classList.add('opacity-70');
        errorText.classList.add('hidden');

        if (!navigator.geolocation) {
            showError("Geolocation is not supported by your browser.");
            return;
        }

        navigator.geolocation.getCurrentPosition(async (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;

            try {
                // Using OpenStreetMap Nominatim API for free reverse geocoding
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=10`);
                const data = await response.json();
                
                // Extracting district, county, or city from the response
                let district = data.address?.state_district || data.address?.county || data.address?.city || data.address?.town;
                
                if (district) {
                    // Clean up string (e.g., remove "District" word if present)
                    district = district.replace(/ District/gi, '').trim();
                    input.value = district;
                    
                    // Show success state briefly
                    fetchText.textContent = "Done!";
                    icon.classList.remove('animate-spin');
                    icon.textContent = "check";
                    setTimeout(resetBtn, 2000);
                } else {
                    showError("Could not identify district from your location.");
                }
            } catch (error) {
                showError("Failed to fetch location data. Please type manually.");
            }
        }, (error) => {
            let msg = "Location access denied or unavailable.";
            if(error.code === 1) msg = "Please allow location access in your browser.";
            showError(msg);
        });

        function showError(message) {
            errorText.textContent = message;
            errorText.classList.remove('hidden');
            resetBtn();
        }

        function resetBtn() {
            fetchText.textContent = "Fetch";
            icon.classList.remove('animate-spin');
            icon.textContent = "my_location";
            btn.disabled = false;
            btn.classList.remove('opacity-70');
        }
    });
  </script>
</body>
</html>
